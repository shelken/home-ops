{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",
  packageRules: [
    {
      description: "Cert-Manager Group",
      groupName: "Cert-Manager",
      matchDatasources: ["docker"],
      matchPackageNames: ["/cert-manager/"],
      group: {
        commitMessageTopic: "{{{groupName}}} group",
      },
    },
    {
      description: "CoreDNS Group",
      groupName: "CoreDNS",
      matchDatasources: ["docker"],
      matchPackageNames: ["/coredns/"],
      group: {
        commitMessageTopic: "{{{groupName}}} group",
      },
    },
    {
      description: "Flux Operator Group",
      groupName: "Flux Operator",
      matchPackageNames: ["/flux-operator/", "/flux-instance/"],
      matchDatasources: ["docker"],
      group: {
        commitMessageTopic: "{{{groupName}}} group",
      },
    },
    {
      description: "Spegel Group",
      groupName: "Spegel",
      matchDatasources: ["docker"],
      matchPackageNames: ["/spegel/"],
      group: {
        commitMessageTopic: "{{{groupName}}} group",
      },
    },
    {
      description: "Immich Group",
      groupName: "Immich",
      matchDatasources: ["docker"],
      matchPackageNames: ["/immich-app/"],
      group: {
        commitMessageTopic: "{{{groupName}}} group",
      },
    },
    {
      description: "Dragonfly Group",
      groupName: "Dragonfly",
      matchDatasources: ["docker"],
      matchPackageNames: ["/dragonflydb/"],
      group: {
        commitMessageTopic: "{{{groupName}}} group",
      },
    },
    {
      description: "DockerProxy Group",
      groupName: "DockerProxy",
      matchDatasources: ["docker"],
      matchPackageNames: ["/tecnativa/docker-socket-proxy/"],
      group: {
        commitMessageTopic: "{{{groupName}}} group",
      },
    },
    {
      description: "CNPG barman-cloud",
      groupName: "CNPG barman-cloud",
      matchPackageNames: [
        "/cloudnative-pg/plugin-barman-cloud/",
        "/cloudnative-pg/charts/plugin-barman-cloud/",
      ],
      group: {
        commitMessageTopic: "{{{groupName}}} group",
      },
    },
    {
      description: "Volsync Group",
      groupName: "Volsync",
      matchDatasources: ["docker"],
      matchPackageNames: ["/perfectra1n/"],
      group: {
        commitMessageTopic: "{{{groupName}}} group",
      },
    },
    {
      description: "Kopia Group",
      groupName: "Kopia",
      matchDatasources: ["docker"],
      matchPackageNames: ["/kopia/"],
      group: {
        commitMessageTopic: "{{{groupName}}} group",
      },
    },
    {
      description: "Ansible Collections",
      groupName: "Ansible Collections",
      matchManagers: ["ansible-galaxy"],
      group: {
        commitMessageTopic: "{{{groupName}}} group",
      },
    },
    {
      description: "Gatus Group",
      groupName: "Gatus",
      matchPackageNames: [
        "/twin/gatus/",
        "/home-operations/gatus-sidecar/",
      ],
      group: {
        commitMessageTopic: "{{{groupName}}} group",
      },
    },
    {
      description: "Envoy Gateway Group",
      groupName: "Envoy Gateway",
      matchPackageNames: [
        "/envoyproxy/gateway-helm/",
        "/envoyproxy/envoy/",
      ],
      group: {
        commitMessageTopic: "{{{groupName}}} group",
      },
    },
  ],
}
