#!/bin/sh /etc/rc.common
# 由 home-ops 下发（router/dae/dae.init），覆盖 opkg 包自带脚本：
# 保留日志时间戳、日志 10×20MB、停止时不删日志；不读 UCI，启停只看 rc.d
# USE_PROCD、START 由 /etc/rc.common 读取
# shellcheck disable=SC2034

USE_PROCD=1
START=99

extra_command "hot_reload" "Hot-reload service"

PROG="/usr/bin/dae"
CONFIG="/etc/dae/config.dae"
LOG_DIR="/var/log/dae"
# dae 不会自动刷新订阅，只在启动与 reload 时拉取
REFRESH_SECONDS=21600

start_service() {
	"$PROG" validate -c "$CONFIG" || return 1
	mkdir -p "$LOG_DIR"

	procd_open_instance dae
	procd_set_param command "$PROG" run
	procd_append_param command --config "$CONFIG"
	procd_append_param command --logfile "$LOG_DIR/dae.log"
	procd_append_param command --logfile-maxbackups 10
	procd_append_param command --logfile-maxsize 20
	procd_set_param limits core="unlimited"
	procd_set_param limits nofile="1000000 1000000"
	procd_set_param respawn
	procd_set_param stderr 1
	procd_close_instance

	procd_open_instance refresh
	procd_set_param command /bin/sh -c "while sleep $REFRESH_SECONDS; do /etc/init.d/dae hot_reload; done"
	procd_set_param respawn
	procd_close_instance
}

hot_reload() {
	/etc/init.d/dae running && "$PROG" reload "$(cat /var/run/dae.pid)"
}
