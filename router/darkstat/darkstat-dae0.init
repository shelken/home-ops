#!/bin/sh /etc/rc.common
# darkstat-dae0: 统计 dae eBPF 通道 (dae0) 上被代理流量的原始目标与真实字节
# 由 home-ops router/darkstat/darkstat-dae0.init 声明式管理，禁止在路由器上手改
# shellcheck disable=SC2034  # START/USE_PROCD 由 /etc/rc.common 框架消费
START=99
USE_PROCD=1

start_service() {
    # /var 重启即失，chroot 目录需自建并授权给 nobody (darkstat --user)
    mkdir -p /var/lib/darkstat-dae0
    chown nobody:nogroup /var/lib/darkstat-dae0
    procd_open_instance
    procd_set_param command /usr/sbin/darkstat --no-daemon -i dae0 -p 668 --chroot /var/lib/darkstat-dae0 --user nobody --import darkstat.db --export darkstat.db
    procd_set_param respawn
    procd_set_param stderr 1
    procd_close_instance
}
